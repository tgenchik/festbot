# true — разработка без MAX: чат бота открывается в браузере на http://localhost:8080,
# токен не нужен. Для работы с настоящим MAX поставить false и заполнить BOT_TOKEN.
DEV_MODE=true

# Токен бота из MasterBot
BOT_TOKEN=
# Пусто — long polling (локально). В проде: публичный https-адрес /webhook и секрет
WEBHOOK_URL=
WEBHOOK_SECRET=

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Часовой пояс, по которому считается «день» акции
TZ_CAMPAIGN=Europe/Moscow
# Розыгрыш за прошедший день (cron в часовом поясе кампании)
DAILY_DRAW_CRON=10 0 * * *
RECHECK_SUBSCRIPTION=true

MAX_CHANCES=10
FINAL_WINNERS=5
FINAL_RESERVES=5
FINAL_PRIZE=2 билета на главный концерт
CLAIM_TTL=72h

# Общий лимит исходящих сообщений в секунду (сверить с лимитами MAX)
SEND_RATE_PER_SEC=25

WELCOME_IMAGE_URL=
RULES_URL=
